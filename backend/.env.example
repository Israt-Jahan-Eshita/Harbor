# Database
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/harbor_dev
TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/harbor_test

# LLM & Speech APIs
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
STT_MODEL=whisper-large-v3
VISION_MODEL=gemini-2.5-flash

# App & Security
ENV=dev
TZ=Asia/Dhaka
CORS_ORIGINS=http://localhost:3000
SESSION_SECRET=replace-with-random-secret
TICK_SECRET=replace-with-random-tick-secret

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:caregiver@example.com

# Email Fallback (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Scoring Weights (optional overrides)
SCORE_W1_STOCK=0.25
SCORE_W2_EXPIRY=0.15
SCORE_W3_SEASON=0.10
SCORE_W4_HEALTH=0.15
SCORE_W5_TASTE=0.10
SCORE_W6_PRICE=0.15
SCORE_W7_REPEAT=0.30

# Reminder Offsets in minutes (optional overrides)
OFFSET_AFTER_FOOD_MIN=20
OFFSET_BEFORE_FOOD_MIN=-30
OFFSET_WITH_FOOD_MIN=0
OFFSET_ANY_MIN=0
REMINDER_GRACE_MINUTES=30
